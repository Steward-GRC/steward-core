# Local development settings. Copy to .env (git-ignored) and load it in the
# run target, for example with `dotenv: ['.env']` in the Taskfile.
#
# Local dev logs everything in human-readable form. Cluster environments set
# their own level and always log JSON: dev cluster debug, qa/staging info,
# production error.
LOG_LEVEL=trace
LOG_FORMAT=console

# Required.
DATABASE_DSN=postgres://core:core@localhost:5432/core?sslmode=disable
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# 32 random bytes, base64. Encrypts the secrets core stores; keep it with the
# database backups, or the stored email-service key can't be read back.
CORE_SETTINGS_KEY=

# Optional: the read cache (Redis or Valkey) and editor images (S3, such as
# RustFS). Both are off when unset.
REDIS_ADDR=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
